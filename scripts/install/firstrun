#!/bin/bash
#
# firstrun — bring a freshly installed machine up to speed.
#
# Usage: firstrun [server|desktop] [options]
#
#   server              a machine that never runs anything graphical: the small
#                       set of packages, the shell and editor config, mise with
#                       its core tools
#   desktop             a desktop or laptop: everything a server gets, plus the
#                       graphical apps, fonts and the full set of mise tools
#
#   -y, --yes           ask nothing: take the recorded answers, or the defaults
#   -n, --dry-run       show what would run, and change nothing
#       --only STEPS    run only these steps (comma-separated)
#       --with MODS     turn on these optional modules (comma-separated)
#       --reconfigure   ask the questions again, even if they are answered
#       --list          list the steps and optional modules, then exit
#   -h, --help          show this help
#
# The first run asks which profile this machine is and which optional modules it
# wants, and records the answers in ~/.config/dotfiles/host.conf. That file is
# per-machine and stays out of the repo; ./setup and `uq` read it too. Later
# runs use it without asking.
#
# Every step is safe to repeat, so the fix for a failed run is to run it again
# (or just the step: `firstrun --only mise`). apt and mise are kept quiet; what
# they printed is under ~/.local/state/firstrun/, one .full.log per step.
#
# On a machine with nothing on it yet, this file can be run straight off GitHub;
# it clones the dotfiles and carries on from the clone:
#
#   curl -fsSL https://raw.githubusercontent.com/jeffjose/dotfiles/master/scripts/install/firstrun | bash -s -- server
#
# Nothing here handles a secret: this repo is public. What needs one (GitHub
# login, the sealed files) is listed at the end for you to do by hand.
#
# FreeBSD has its own, smaller script: firstrun-bsd.
#
# Jeffrey Jose | Jan 17, 2021

# bash reads a script as it goes, so one that is edited or replaced mid-run goes
# on from the same byte offset in the new text. Wrapping the whole script in a
# group makes bash read all of it before running any of it — which is also what
# makes `curl ... | bash` safe against a download cut off half way.
{

set -u

DOTFILES_DIR="$HOME/dotfiles"
REPO_URL="https://github.com/jeffjose/dotfiles.git"
DEB_DOWNLOADER_URL="https://github.com/jeffjose/deb-downloader.git"

# --- Bootstrap ---------------------------------------------------------------
# Nothing below this block works without the repo, so get it first. This part
# cannot use anything from the repo.
if [ ! -d "$DOTFILES_DIR/.git" ]; then
  echo "firstrun: no dotfiles at $DOTFILES_DIR yet — cloning $REPO_URL"
  if ! command -v git >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      sudo apt-get update -qq && sudo apt-get install -y git || exit 1
    else
      echo "firstrun: git is not installed, and this is not an apt system. Install git and run this again." >&2
      exit 1
    fi
  fi
  git clone "$REPO_URL" "$DOTFILES_DIR" || exit 1
  # Piped from curl, stdin is the script. The questions need the terminal.
  if [ ! -t 0 ] && (: </dev/tty) 2>/dev/null; then
    exec "$DOTFILES_DIR/scripts/install/firstrun" "$@" </dev/tty
  fi
  exec "$DOTFILES_DIR/scripts/install/firstrun" "$@"
fi

source "$DOTFILES_DIR/scripts/lib/ui.sh"
source "$DOTFILES_DIR/scripts/lib/host.sh"

# --- Steps and modules -------------------------------------------------------
# name | who gets it | what it does. Each has a step_<name> function below, with
# dashes as underscores. `all` is every machine, `desktop` only that profile,
# and `module:<name>` only a machine that chose that optional module.
STEPS=(
  "apt|all|apt packages (packages/apt-*.txt)"
  "shell|all|tcsh as the login shell"
  "dotfiles|all|directories and symlinks (./setup)"
  "mise|all|mise and the tools it manages"
  "ssh-key|all|an ssh key, if there is none"
  "nvim|all|neovim plugins"
  "fonts|desktop|fonts kept in the repo"
  "debs|desktop|Chrome and the other debs in misc/package.toml"
  "code|desktop|VS Code (AppImage)"
  "terminal|desktop|tilix settings and the drop-down terminal shortcut"
  "groups|desktop|plugdev membership, for adb"
  "claude-remote|module:claude-remote|Claude Code remote-control service"
)

# The steps that use sudo. If none of them is going to run, nobody is asked for
# a password.
ROOT_STEPS="apt shell debs code groups"

# name | which profiles may have it | what it adds. A module can bring apt
# packages (packages/apt-<name>.txt), a step above, or both.
MODULES=(
  "claude-remote|all|Claude Code remote control as a systemd user service"
)

# --- Arguments ---------------------------------------------------------------
PROFILE_ARG="" ASSUME_YES=0 DRY_RUN=0 RECONFIGURE=0 LIST=0 ONLY="" WITH="" WITH_SET=0

usage() { sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; }

while [ $# -gt 0 ]; do
  case "$1" in
    server | desktop) PROFILE_ARG="$1" ;;
    gui) PROFILE_ARG=desktop ;; # the old name
    -y | --yes) ASSUME_YES=1 ;;
    -n | --dry-run) DRY_RUN=1 ;;
    --reconfigure) RECONFIGURE=1 ;;
    --list) LIST=1 ;;
    --only)
      ONLY="${2:-}"
      shift
      ;;
    --only=*) ONLY="${1#*=}" ;;
    --with)
      WITH="${2:-}" WITH_SET=1
      shift
      ;;
    --with=*) WITH="${1#*=}" WITH_SET=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      err "unknown argument: $1"
      detail "see: firstrun --help" >&2
      exit 2
      ;;
  esac
  shift
done

if [ "$LIST" -eq 1 ]; then
  say "$CYAN" "Steps" ""
  for row in "${STEPS[@]}"; do
    IFS='|' read -r name who what <<<"$row"
    printf '%12s %-18s %-26s %s\n' '' "$name" "$DIM$who$RESET" "$what"
  done
  say "$CYAN" "Modules" ""
  for row in "${MODULES[@]}"; do
    IFS='|' read -r name who what <<<"$row"
    printf '%12s %-18s %-26s %s\n' '' "$name" "$DIM$who$RESET" "$what"
  done
  exit 0
fi

if [ "$(id -u)" -eq 0 ]; then
  err "run firstrun as yourself, not as root; it uses sudo where it needs to"
  detail "no user yet? create one first, then log in as them:" >&2
  detail "  $DOTFILES_DIR/scripts/install/setup_user <name>" >&2
  exit 1
fi

# --- Questions ---------------------------------------------------------------
# ask <question> <default>: read one line from the terminal
ask() {
  local reply=""
  if [ "$ASSUME_YES" -eq 0 ] && (: </dev/tty) 2>/dev/null; then
    printf '%s%12s%s %s %s[%s]%s ' "$CYAN" "?" "$RESET" "$1" "$DIM" "$2" "$RESET" >/dev/tty
    read -r reply </dev/tty || reply=""
  fi
  printf '%s' "${reply:-$2}"
}

module_names() { printf '%s\n' "${MODULES[@]}" | cut -d'|' -f1; }

# Settle PROFILE and MODULE_LIST: the command line wins, then what host.conf
# already says, then a question, with a guess as its default.
configure() {
  local recorded_profile recorded_modules have_conf=0
  [ -f "$HOST_CONF" ] && have_conf=1
  recorded_profile=$(host_conf_get profile)
  recorded_modules=$(host_conf_get modules)
  [ "$RECONFIGURE" -eq 1 ] && have_conf=0

  PROFILE="$PROFILE_ARG"
  if [ -z "$PROFILE" ] && [ "$have_conf" -eq 1 ]; then
    PROFILE="$recorded_profile"
  fi
  while [ "$PROFILE" != server ] && [ "$PROFILE" != desktop ]; do
    PROFILE=$(ask "Is this a server or a desktop?" "${recorded_profile:-$(detect_profile)}")
    case "$PROFILE" in
      s | srv) PROFILE=server ;;
      d | gui | laptop) PROFILE=desktop ;;
    esac
  done

  local row name who what answer default
  MODULE_LIST=""
  if [ "$WITH_SET" -eq 1 ]; then
    for name in ${WITH//,/ }; do
      if ! module_names | grep -qxF -- "$name"; then
        err "no such module: $name"
        detail "see: firstrun --list" >&2
        exit 2
      fi
      MODULE_LIST+="$name "
    done
  elif [ "$have_conf" -eq 1 ]; then
    MODULE_LIST="$recorded_modules"
  else
    for row in "${MODULES[@]}"; do
      IFS='|' read -r name who what <<<"$row"
      [ "$who" = all ] || [ "$who" = "$PROFILE" ] || continue
      default=n
      case " $recorded_modules " in *" $name "*) default=y ;; esac
      answer=$(ask "Add $name — $what?" "$default")
      case "$answer" in y | Y | yes) MODULE_LIST+="$name " ;; esac
    done
  fi
  MODULE_LIST="${MODULE_LIST% }"

  export DOTFILES_PROFILE="$PROFILE"
  [ "$DRY_RUN" -eq 1 ] && return 0
  if [ "$recorded_profile" != "$PROFILE" ] || [ "$recorded_modules" != "$MODULE_LIST" ] || [ ! -f "$HOST_CONF" ]; then
    mkdir -p "${HOST_CONF%/*}"
    {
      echo "# This machine's answers to firstrun. Per-machine; not part of the dotfiles."
      echo "profile=$PROFILE"
      echo "modules=\"$MODULE_LIST\""
    } >"$HOST_CONF"
    say "$GREEN" "Recorded" "${HOST_CONF/#$HOME/\~}"
  fi
}

has_module() {
  case " $MODULE_LIST " in *" $1 "*) return 0 ;; esac
  return 1
}

# --- Steps -------------------------------------------------------------------
# Each prints what it changed and returns non-zero if it could not finish. They
# run in a subshell, with their output copied to a log.

# quietly <command...>: run a command without its output on screen. All of it
# goes to the step's .full.log; if the command fails, the end of that is shown.
quietly() {
  local log="$LOG_DIR/$STEP.full.log" status=0
  "$@" >>"$log" 2>&1 || status=$?
  [ "$status" -eq 0 ] && return 0
  err "$1 ${2:-} failed (exit $status); the last of what it said:"
  sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r/\n/g' "$log" | grep -v '^[[:space:]]*$' | tail -n 8 |
    while IFS= read -r line; do detail "$DIM$line$RESET" >&2; done
  detail "full output in ${log/#$HOME/\~}" >&2
  return "$status"
}

# mise_install [tool...]: `mise install` with one line per tool as it lands, in
# place of mise's progress display. The rest goes to the step's .full.log.
mise_install() {
  local log="$LOG_DIR/$STEP.full.log" status
  mise install --yes "$@" 2>&1 | tee -a "$log" |
    sed -u -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r/\n/g' |
    awk -v green="$GREEN" -v reset="$RESET" '
      /^mise ✓ [^ ]+@[^ ]+/ {
        tool = $3
        at = match(tool, /@[^@]*$/)
        name = substr(tool, 1, at - 1); version = substr(tool, at + 1)
        sub(/.*[:\/]/, "", name)
        if (!seen[name]++) { printf "%s%12s%s %s %s\n", green, "Installed", reset, name, version; fflush() }
      }'
  status=${PIPESTATUS[0]}
  [ "$status" -eq 0 ] && return 0
  err "mise install failed (exit $status); the last of what it said:"
  sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r/\n/g' "$log" | grep -i -E 'error|fail|not found|denied' | awk '!seen[$0]++' | tail -n 8 |
    while IFS= read -r line; do detail "$DIM$line$RESET" >&2; done
  detail "full output in ${log/#$HOME/\~}" >&2
  # Most of the tools are GitHub releases, and GitHub allows an address 60
  # anonymous API requests an hour.
  if grep -q -E '403 Forbidden|rate limit' "$log"; then
    detail "GitHub is rate-limiting this address. Wait an hour, or give mise a token" >&2
    detail "(export GITHUB_TOKEN=...), then: firstrun --only mise" >&2
  fi
  return "$status"
}

# The package names in a packages/*.txt file, comments and blanks dropped.
package_names() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$@"; }

step_apt() {
  local -a lists=("$DOTFILES_DIR/packages/apt-server.txt")
  [ "$PROFILE" = desktop ] && lists+=("$DOTFILES_DIR/packages/apt-desktop.txt")
  local module
  for module in $MODULE_LIST; do
    [ -f "$DOTFILES_DIR/packages/apt-$module.txt" ] && lists+=("$DOTFILES_DIR/packages/apt-$module.txt")
  done

  if ! command -v apt-get >/dev/null 2>&1; then
    warn "no apt-get here; install these by hand:"
    detail "$(package_names "${lists[@]}" | paste -sd' ' -)" >&2
    return 0
  fi

  local pkg total=0
  local -a missing=() installable=() unknown=()
  while IFS= read -r pkg; do
    ((total++)) || true
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed' || missing+=("$pkg")
  done < <(package_names "${lists[@]}")

  if [ ${#missing[@]} -eq 0 ]; then
    say "$DIM" "Fresh" "$DIM$total apt packages$RESET"
    return 0
  fi

  quietly sudo apt-get update || warn "carrying on with the package lists there are"
  for pkg in "${missing[@]}"; do
    if apt-cache show "$pkg" 2>/dev/null | grep -q '^Package:'; then
      installable+=("$pkg")
    else
      unknown+=("$pkg")
    fi
  done
  [ ${#unknown[@]} -eq 0 ] || say "$DIM" "Skipped" "${DIM}not in this distro's repos: ${unknown[*]}$RESET"
  [ ${#installable[@]} -gt 0 ] || return 0

  say "$GREEN" "Installing" "${#installable[@]} apt packages"
  fold -s -w 76 <<<"${installable[*]}" | while IFS= read -r line; do detail "$DIM$line$RESET"; done
  quietly sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${installable[@]}"
}

step_shell() {
  local want have
  want=$(command -v tcsh) || {
    err "tcsh is not installed (the apt step installs it)"
    return 1
  }
  have=$(getent passwd "$USER" | cut -d: -f7)
  if [ "$have" = "$want" ] || [ "$have" = /bin/tcsh ] || [ "$have" = /usr/bin/tcsh ]; then
    say "$DIM" "Fresh" "${DIM}login shell is $have$RESET"
    return 0
  fi
  sudo chsh -s "$want" "$USER" || return 1
  say "$GREEN" "Changed" "login shell ${have:-?} → $want (from the next login)"
}

step_dotfiles() { "$DOTFILES_DIR/setup"; }

step_mise() {
  export PATH="$HOME/.cargo/bin:$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
  if command -v mise >/dev/null 2>&1; then
    say "$DIM" "Fresh" "${DIM}mise $(mise --version 2>/dev/null | awk '{print $1}')$RESET"
  else
    # The prebuilt binary, into ~/.local/bin. (This used to be `cargo install
    # mise`, a ten-minute compile that needed rust before mise could provide it.)
    say "$GREEN" "Installing" "mise"
    quietly sh -c 'curl -fsSL https://mise.run | sh' || return 1
    command -v mise >/dev/null 2>&1 || {
      err "mise installed, but it is not at ~/.local/bin/mise"
      return 1
    }
  fi

  if [ ! -e "$HOME/.config/mise/config.toml" ]; then
    err "~/.config/mise/config.toml is missing (the dotfiles step links it)"
    return 1
  fi

  local status=0 missing
  missing=$(mise ls --current --missing 2>/dev/null | awk '{print $1}')
  if [ -z "$missing" ]; then
    say "$DIM" "Fresh" "$DIM$(mise ls --current 2>/dev/null | wc -l) mise tools$RESET"
    return 0
  fi

  # rust first: the cargo: tools are built with it.
  say "$CYAN" "Installing" "mise tools ${DIM}(the ones built from source take a few minutes each)$RESET"
  mise_install rust || status=1
  mise_install || status=1

  missing=$(mise ls --current --missing 2>/dev/null | awk '{print $1}' | paste -sd' ' -)
  if [ -n "$missing" ]; then
    err "not installed: $missing"
    status=1
  fi
  return $status
}

step_ssh_key() {
  local key
  for key in id_ed25519 id_ecdsa id_rsa; do
    if [ -f "$HOME/.ssh/$key" ]; then
      say "$DIM" "Fresh" "$DIM~/.ssh/$key$RESET"
      return 0
    fi
  done
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  ssh-keygen -q -t ed25519 -N "" -C "$USER@$(hostname -s 2>/dev/null || hostname)" -f "$HOME/.ssh/id_ed25519" || return 1
  say "$GREEN" "Created" "~/.ssh/id_ed25519 (no passphrase)"
}

step_nvim() {
  export PATH="$HOME/.local/share/mise/shims:$PATH"
  command -v nvim >/dev/null 2>&1 || {
    err "nvim is not installed (the mise step installs it)"
    return 1
  }
  local plug="$HOME/.local/share/nvim/site/autoload/plug.vim"
  if [ ! -f "$plug" ]; then
    say "$GREEN" "Installing" "vim-plug"
    curl -fsSLo "$plug" --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim || return 1
  fi
  # Quietly: on a new machine init.vim complains about the very plugins this is
  # about to install. What counts is that they are there afterwards.
  local plugged="$HOME/.local/share/nvim/plugged" before after
  before=$(find "$plugged" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
  nvim --headless +PlugInstall +qall >/dev/null 2>&1
  after=$(find "$plugged" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
  if [ "$after" -eq 0 ]; then
    err "no neovim plugins were installed; try :PlugInstall in nvim"
    return 1
  elif [ "$after" -gt "$before" ]; then
    say "$GREEN" "Installed" "$((after - before)) neovim plugins"
  else
    say "$DIM" "Fresh" "$DIM$after neovim plugins$RESET"
  fi
}

step_fonts() {
  local dir="$HOME/.local/share/fonts" font copied=0
  mkdir -p "$dir"
  for font in "$DOTFILES_DIR"/themes/apple-system/*.otf; do
    [ -f "$dir/${font##*/}" ] && continue
    cp "$font" "$dir/" || return 1
    ((copied++)) || true
  done
  if [ "$copied" -eq 0 ]; then
    say "$DIM" "Fresh" "${DIM}fonts in ~/.local/share/fonts$RESET"
    return 0
  fi
  command -v fc-cache >/dev/null 2>&1 && fc-cache -f
  say "$GREEN" "Installed" "$copied fonts into ~/.local/share/fonts"
}

step_debs() {
  # update_deb.sh drives deb-downloader, which lives in its own repo and runs
  # under uv (one of the core mise tools).
  export PATH="$HOME/.local/share/mise/shims:$PATH"
  if [ ! -x "$HOME/scripts/deb-downloader/deb-downloader" ]; then
    say "$GREEN" "Cloning" "deb-downloader into ~/scripts"
    mkdir -p "$HOME/scripts"
    git clone --quiet "$DEB_DOWNLOADER_URL" "$HOME/scripts/deb-downloader" || return 1
  fi
  "$DOTFILES_DIR/scripts/update/update_deb.sh"
}

step_code() { "$DOTFILES_DIR/scripts/update/update_code.sh"; }

step_terminal() {
  if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] || [ -z "${XDG_CURRENT_DESKTOP:-}" ]; then
    say "$YELLOW" "Skipped" "not in a desktop session; run \`firstrun --only terminal\` from one"
    return 0
  fi
  if command -v tilix >/dev/null 2>&1 && command -v dconf >/dev/null 2>&1; then
    dconf load /com/gexperts/Tilix/ <"$DOTFILES_DIR/desktop/tilix.dconf" || return 1
    say "$GREEN" "Loaded" "tilix settings"
  fi
  # Ctrl+Space drops a terminal down: tilix's quake mode on XFCE, the ddterm
  # extension under GNOME Shell.
  case "$XDG_CURRENT_DESKTOP" in
    *XFCE*)
      xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Primary>space' -n -t string -s 'tilix --quake' || return 1
      say "$GREEN" "Bound" "Ctrl+Space → tilix --quake"
      ;;
    *GNOME*) "$DOTFILES_DIR/scripts/install/ddterm.sh" ;;
    *) say "$DIM" "Skipped" "${DIM}no drop-down terminal setup for $XDG_CURRENT_DESKTOP$RESET" ;;
  esac
}

step_groups() {
  if id -nG "$USER" | tr ' ' '\n' | grep -qx plugdev; then
    say "$DIM" "Fresh" "$DIM$USER is in plugdev$RESET"
    return 0
  fi
  getent group plugdev >/dev/null || {
    say "$DIM" "Skipped" "${DIM}no plugdev group here$RESET"
    return 0
  }
  sudo usermod -aG plugdev "$USER" || return 1
  say "$GREEN" "Added" "$USER to plugdev (from the next login)"
}

step_claude_remote() {
  if is_corp_host; then
    say "$YELLOW" "Skipped" "claude is kept off corp hosts"
    return 0
  fi
  export PATH="$HOME/.local/share/mise/shims:$PATH"
  # The one part that needs the terminal: logging in opens a prompt, which
  # `quietly` would swallow. Do it here, out in the open, so that the script
  # below finds it done and has nothing left to ask.
  if command -v claude >/dev/null 2>&1 &&
    ! claude auth status 2>/dev/null | jq -e '.loggedIn == true' >/dev/null 2>&1; then
    say "$CYAN" "Logging in" "to Claude — the service needs a subscription login"
    claude auth login || return 1
  fi
  quietly "$DOTFILES_DIR/scripts/install/claude-remote-control.sh" || return 1
  if systemctl --user is-active --quiet claude-remote-control.service; then
    say "$GREEN" "Running" "claude-remote-control.service ${DIM}connect from the Claude app or claude.ai/code$RESET"
  else
    err "claude-remote-control.service is not running"
    detail "journalctl --user -u claude-remote-control.service -n 30" >&2
    return 1
  fi
}

# --- Running -----------------------------------------------------------------
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/firstrun/$(date +%Y%m%d-%H%M%S)"
declare -a planned=() done_steps=() failed_steps=()

# The steps this run is for, in order: the profile's and the chosen modules',
# narrowed by --only.
plan() {
  local row name who what
  for row in "${STEPS[@]}"; do
    IFS='|' read -r name who what <<<"$row"
    case "$who" in
      all) ;;
      desktop) [ "$PROFILE" = desktop ] || continue ;;
      module:*) has_module "${who#module:}" || continue ;;
    esac
    if [ -n "$ONLY" ]; then
      case ",$ONLY," in *",$name,"*) ;; *) continue ;; esac
    fi
    planned+=("$name|$what")
  done

  local wanted
  for wanted in ${ONLY//,/ }; do
    if ! printf '%s\n' "${STEPS[@]}" | cut -d'|' -f1 | grep -qxF -- "$wanted"; then
      err "no such step: $wanted"
      detail "see: firstrun --list" >&2
      exit 2
    elif ! printf '%s\n' "${planned[@]}" | cut -d'|' -f1 | grep -qxF -- "$wanted"; then
      warn "$wanted is not a step for this machine ($PROFILE${MODULE_LIST:+, with $MODULE_LIST}); skipping it"
    fi
  done
}

# sudo asks once, here, rather than at whichever step first needs it; then the
# credential is kept warm, since the mise step can outlast its timeout.
warm_sudo() {
  command -v sudo >/dev/null 2>&1 || {
    warn "sudo is not installed; the steps that need root will fail"
    return 0
  }
  sudo -n true 2>/dev/null || sudo -v || {
    warn "could not authorise sudo; the steps that need root may fail or ask again"
    return 0
  }
  (while sleep 50; do
    kill -0 "$$" 2>/dev/null || exit 0
    sudo -n true 2>/dev/null || exit 0
  done) &
  SUDO_KEEPALIVE_PID=$!
  trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null' EXIT
}

run_step() {
  local name="$1" what="$2" n="$3" started status
  started=$(now_us)
  echo
  say "$CYAN" "Setting up" "$name $DIM[$n/${#planned[@]}] $what$RESET"
  STEP="$name"
  ("step_${name//-/_}") 2>&1 | tee "$LOG_DIR/$name.log"
  status=${PIPESTATUS[0]}
  if [ "$status" -eq 0 ]; then
    say "$GREEN" "Done" "$name ${DIM}in $(elapsed "$started")$RESET"
    done_steps+=("$name")
  else
    say "$RED" "Failed" "$name (exit $status) ${DIM}after $(elapsed "$started")$RESET"
    failed_steps+=("$name")
  fi
}

next_steps() {
  echo
  say "$CYAN" "Next" "by hand — none of this can live in a public repo:"
  detail "gh auth login                       GitHub, for gh and for git over https"
  detail "~/.aliases.sensitive.sh             private aliases; ./setup left it empty"
  detail "seal                                unlock the sealed files in ~/dotfiles/encrypted"
  [ "$PROFILE" != desktop ] || detail "appimage install -i                 pick the other apps from the catalog"
  detail "log out and back in                 for the new login shell and groups"
  if [ -f "$HOME/.ssh/id_ed25519.pub" ] && git -C "$DOTFILES_DIR" remote get-url origin 2>/dev/null | grep -q '^https://'; then
    detail "to push dotfiles from here, add ~/.ssh/id_ed25519.pub to GitHub, then:"
    detail "  git -C ~/dotfiles remote set-url origin git@github.com:jeffjose/dotfiles.git"
  fi
}

main() {
  local start_us row n=0
  start_us=$(now_us)

  configure
  plan

  say "$CYAN" "Profile" "$BOLD$PROFILE$RESET${MODULE_LIST:+ with $MODULE_LIST}$(is_corp_host && printf ' %s(corp host)%s' "$YELLOW" "$RESET")"

  if [ "$DRY_RUN" -eq 1 ]; then
    for row in "${planned[@]}"; do
      say "$DIM" "Would run" "${row%%|*}  $DIM${row#*|}$RESET"
    done
    say "$GREEN" "Finished" "dry run: ${#planned[@]} steps, nothing changed"
    exit 0
  fi
  [ ${#planned[@]} -gt 0 ] || {
    err "nothing to run"
    exit 2
  }

  mkdir -p "$LOG_DIR"
  for row in "${planned[@]}"; do
    case " $ROOT_STEPS " in *" ${row%%|*} "*)
      warm_sudo
      break
      ;;
    esac
  done
  for row in "${planned[@]}"; do
    ((n++)) || true
    run_step "${row%%|*}" "${row#*|}" "$n"
  done

  [ -n "$ONLY" ] || next_steps

  echo
  if [ ${#failed_steps[@]} -gt 0 ]; then
    for row in "${failed_steps[@]}"; do
      say "$RED" "Failed" "$row — output in ${LOG_DIR/#$HOME/\~}/$row.log"
    done
    say "$RED" "Finished" "${#failed_steps[@]} failed, ${#done_steps[@]} done in $(elapsed "$start_us"); fix and run: firstrun --only $(
      IFS=,
      echo "${failed_steps[*]}"
    )"
    exit 1
  fi
  local noun=steps
  [ ${#done_steps[@]} -eq 1 ] && noun=step
  say "$GREEN" "Finished" "${#done_steps[@]} $noun in $(elapsed "$start_us")"
  exit 0
}

main

}
