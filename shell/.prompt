# Prompt

# Debug timing - capture start time if PROMPT_DEBUG is set
if ($?PROMPT_DEBUG) then
    set prompt_start_time = `date +%s%3N`  # milliseconds since epoch
endif

# Early exit for TWIG mode - skip all the expensive logic
if ($?TWIG) then
    if ($TWIG == "true") then
        set prompt = "`$HOME/scripts/twig/target/debug/twig --mode tcsh`"
        goto prompt_debug_end
    endif
endif

    set     red="%{\033[1;31m%}"
    set   green="%{\033[0;32m%}"
    set  yellow="%{\033[1;33m%}"
    set    blue="%{\033[1;34m%}"
    set magenta="%{\033[1;35m%}"
    set    cyan="%{\033[1;36m%}"
    set   white="%{\033[0;37m%}"
    set  orange="%{\033[1;38;5;208m%}"   # 256-colour
    set  violet="%{\033[1;38;5;141m%}"   # 256-colour
    set     end="%{\033[0m%}"    # This is needed at the end... :(

    #set prompt='[%n@%m %B%c%b]%# '
    set ellipsis

#if(`where iwgetid` == "") then
#    set WIFI = ""
#else
#    set WIFI = `iwgetid -r | tr ' ' '.' | tr '[A-Z]' '[a-z]' | sed 's/^@//g'`
#endif


# Colours shared by every machine
set time_color = "${cyan}"
set cwd_color = "${green}"
set git_branch_color = "${magenta}"
set git_untracked_color = "${red}"
set git_changed_color = "${yellow}"
set git_staged_color = "${blue}"
set git_stashed_color = "${cyan}"
set git_clean_color = "${green}"
set git_cl_color = "${blue}"

# === HOST MAP ===
# One case per machine giving its colour.
# A machine that isn't listed is shown in white.
#
# Match on the FQDN rather than on $HOST. tcsh sets $HOST from gethostname(),
# which on the rodete machines is the short name ("jeffjose-glaptop2") — so the
# fully-qualified cases below never matched and every Google box fell through to
# white. The short name also can't tell the cloudtop (jeffjose.c.googlers.com)
# from the workstation (jeffjose.mtv.corp.google.com): both are bare "jeffjose".
# The personal boxes have no domain, so `hostname -f` echoes the short name
# there and the single-word cases still match (with a ".*" twin in case a
# domain ever appears).
# This file is sourced before every prompt, so resolve it once per shell:
# `hostname -f` consults the resolver and can block when that is slow.
if (! $?host_fqdn) then
    set host_fqdn = `hostname -f`
    if ("${host_fqdn}" == "") set host_fqdn = "${HOST}"
endif

set host_name = "${HOST}"
set host_color = "${white}"

switch ("${host_fqdn}")
    # Google machines
    case "jeffjose2.mtv.corp.google.com":
        set host_color = "${cyan}";     breaksw
    case "jeffjose.c.googlers.com":
        set host_color = "${orange}";   breaksw
    case "jeffjose-glaptop.roam.corp.google.com":
    case "jeffjose-glaptop2.roam.corp.google.com":
        set host_color = "${violet}";   breaksw
    case "jeffjose-glapstation":
    case "jeffjose-glapstation.*":
        set host_color = "${magenta}";  breaksw
    case "jeffjose.mtv.corp.google.com":
        set host_color = "${yellow}";   breaksw

    # Personal machines
    case "skyfall":
    case "skyfall.*":
        set host_color = "${yellow}";   breaksw
    case "woodwind":
    case "woodwind.*":
    case "nomad":
    case "nomad.*":
        set host_color = "${blue}";     breaksw

    # Servers
    case "matterhorn":
    case "matterhorn.*":
        set host_color = "${red}";      breaksw
    case "basalt":
    case "basalt.*":
        set host_color = "${magenta}";  breaksw
endsw

set ip_address = `\ip -o route get 8.8.8.8 | awk -F 'src | uid' '{print $2}'`

#if ("${WIFI}" == 'banana-unleashed') then
#    set wifi_color = "${magenta}"
#    set wifi_str = "@${WIFI}"
#else if ("${WIFI}" == '') then
#    set wifi_color = "${red}"
#    set wifi_str = "offline"
#else
#    set wifi_color = "${yellow}"
#    set wifi_str = "@${WIFI}"
#endif

# prodaccess status
#
if ("${host_fqdn}" == "jeffjose.mtv.corp.google.com") then
  if (-d /google/src/files) then
    set prodaccess_status = true
    set prompt_key = "#"
  else
    set prodaccess_status = false
    set prompt_key = "(run prodaccess) #"
  endif
else
  set prodaccess_status = true
  set prompt_key = "#"
endif

# Git
#
if (`bash -c 'git rev-parse --git-dir 2> /dev/null'` != "") then

  set git_status = `~/dotfiles/git/gitstatus.sh`

  set git_branch    = $git_status[1]

  if ($git_status[2] == '_NO_REMOTE_TRACKING_') then
    set git_remote = ''
  else
    set git_remote = "$git_status[2]"
  endif

  if ($git_status[4] == 0) then
    set git_staged = ''
  else
    set git_staged="+${git_status[4]}"
  endif

  if ($git_status[5] == 0) then
    set git_conflicts = ''
  else
    set git_conflicts = "!!$git_status[5]"
  endif

  if ($git_status[6] == 0) then
    set git_changed = ''
  else
    set git_changed="+${git_status[6]}"
  endif

  if ($git_status[7] == 0) then
    set git_untracked = ''
  else
    set git_untracked="+${git_status[7]}"
  endif

  if ($git_status[8] == 0) then
    set git_stashed = ''
  else
    set git_stashed = "+$git_status[8]"
  endif

  if ("$git_status[9]" == 0) then
    set git_clean = ''
  else
    set git_clean="✔"
  endif

  if ("$git_status[10]" != "-") then
    set git5_cl = "$git_status[10]"
  else
    set git5_cl = '-'
  endif

  set git_str = " ${git_branch_color}${git_branch}${git_remote}${end}:${git_untracked_color}${git_untracked}${end}${git_changed_color}${git_changed}${end}${git_staged_color}${git_staged}${end}${git_stashed_color}${git_stashed}${end}${git_clean_color}${git_clean}${end}:${git_cl_color}${git5_cl}${end}"

else
  set git_str = ''
endif


# Firebase checks removed - no longer needed

# Use colorful prompt in screen, VS Code (local), or VS Code Remote Tunnel
set use_color_prompt = 0
if ($?STY) set use_color_prompt = 1
if ($?VSCODE_IPC_HOOK_CLI) set use_color_prompt = 1
if ($?REMOTEHOST) set use_color_prompt = 1
# VSCODE_IPC_HOOK_CLI is only exported when the terminal gets a CLI socket — the
# AppImage's integrated terminals have TERM_PROGRAM but no hook, and without
# this they fell back to the all-white prompt.
if ($?TERM_PROGRAM) then
    if ("${TERM_PROGRAM}" == "vscode") set use_color_prompt = 1
endif

if ($use_color_prompt) then
    set prompt = "-(${time_color}%B%P%b${end} ${host_color}${host_name} ${ip_address}${end} ${cwd_color}%B%/%b${end}${git_str})-\n${prompt_key}${end} "
else
    set prompt = "-(${white}%P${end} ${white}${host_name} ${ip_address}${end} ${white}%/${end})-\n?${end} "
endif

prompt_debug_end:
# Debug timing - calculate and display elapsed time
if ($?PROMPT_DEBUG) then
    if ($?prompt_start_time) then
        set prompt_end_time = `date +%s%3N`
        @ prompt_elapsed = $prompt_end_time - $prompt_start_time
        echo "Prompt took ${prompt_elapsed}ms"
    endif
endif
