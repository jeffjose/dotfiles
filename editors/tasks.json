{
  // User-level VS Code tasks (apply to every folder, local and remote).
  "version": "2.0.0",
  "tasks": [
    {
      // Show the terminal in the bottom panel whenever a folder is opened,
      // including folders that have never been opened before. terminal.focus
      // reuses a restored terminal if there is one, otherwise creates one.
      "label": "Open terminal panel",
      "type": "shell",
      "command": "${command:workbench.action.terminal.focus}",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "never", "close": true },
      "problemMatcher": []
    }
  ]
}
