# Ghostty config — matched to tilix (Monokai, Fira Code Medium 9)
# Source: ~/dotfiles/desktop/tilix.dconf
# Reload in-app with ctrl+shift+, — inspect parsed result with `ghostty +show-config`

# ── Font ─────────────────────────────────────────────────────────
# tilix: 'Fira Code Medium 9'
font-family = Fira Code
font-style = Medium
font-size = 9
# Fira Code ligatures are on by default; uncomment to turn them off:
# font-feature = -calt, -liga, -dlig

# ── Colors (Monokai) ─────────────────────────────────────────────
window-theme = dark
background = 272822
foreground = F8F8F2

palette = 0=#272822
palette = 1=#F92672
palette = 2=#A6E22E
palette = 3=#F4BF75
palette = 4=#66D9EF
palette = 5=#AE81FF
palette = 6=#A1EFE4
palette = 7=#F8F8F2
palette = 8=#75715E
palette = 9=#F92672
palette = 10=#A6E22E
palette = 11=#F4BF75
palette = 12=#66D9EF
palette = 13=#AE81FF
palette = 14=#A1EFE4
palette = 15=#F9F8F5

# ── Cursor ───────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true
# Cursor keeps the cell's colors (matches tilix cursor-colors-set=false).
# Set an explicit color instead by uncommenting:
# cursor-color = #F8F8F2

# ── Window ───────────────────────────────────────────────────────
# tilix had no inner padding; a little breathing room reads nicer.
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
# Slight transparency — set to 1 for fully opaque like tilix default.
background-opacity = 0.98
# Reopen with the same working dir / layout after a restart.
window-save-state = always

# ── Scrollback ───────────────────────────────────────────────────
# Bytes of scrollback to retain (default 10MB). 100MB here.
scrollback-limit = 100000000

# ── Mouse / clipboard ────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true

# ── Behavior ─────────────────────────────────────────────────────
# Don't nag when closing a shell that's just sitting at a prompt.
confirm-close-surface = false
# Shell integration (cwd tracking, jump-to-prompt, etc.) is auto-detected.
shell-integration-features = cursor, sudo, title
