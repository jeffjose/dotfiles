#!/bin/bash
#
# setup — create the directories and symlinks that put these dotfiles in place.
#
# Usage: setup [-v|--verbose]
#
# Safe to run any number of times; `uq` runs it after every pull. What a machine
# gets depends on its profile (scripts/lib/host.sh): a server gets the shell,
# git and editor config, a desktop gets the graphical apps' config as well.
#
set -e # Exit on error

# Constants
DOTFILES_DIR="$HOME/dotfiles"
BACKUP_SUFFIX=".bak.$(date +%Y%m%d_%H%M%S)"

# Directories to create
DIRECTORIES=(
  "$HOME/bin"
  "$HOME/scripts"
  "$HOME/.screen"
  "$HOME/.config/nvim"
  "$HOME/.local/share/nvim/backup"
  "$HOME/.config/containers"
  "$HOME/.config/mise"
  "$HOME/.config/uv"
  "$HOME/.pnpm"
  "$HOME/.config/ranger"
  "$HOME/.config/twig"
  "$HOME/.config"
)

# ... and the ones only a desktop needs
DESKTOP_DIRECTORIES=(
  "$HOME/Downloads"
  "$HOME/.config/Code/User"
  "$HOME/.vscode/extensions"
  "$HOME/.ipython/profile_default"
  "$HOME/.screenlayout"
  "$HOME/.jupyter/custom"
)

# Files to symlink (source:target)
declare -A SYMLINKS=(
  ["$DOTFILES_DIR/shell/.aliases"]="$HOME/.aliases"
  ["$DOTFILES_DIR/shell/.aliases.bash"]="$HOME/.aliases.bash"
  ["$DOTFILES_DIR/apps/.colordiffrc"]="$HOME/.colordiffrc"
  ["$DOTFILES_DIR/shell/.cshrc"]="$HOME/.cshrc"
  ["$DOTFILES_DIR/shell/.cwdcmd"]="$HOME/.cwdcmd"
  ["$DOTFILES_DIR/git/.gitconfig"]="$HOME/.gitconfig"
  ["$DOTFILES_DIR/editors/.pdbrc"]="$HOME/.pdbrc"
  ["$DOTFILES_DIR/shell/.precmd"]="$HOME/.precmd"
  ["$DOTFILES_DIR/shell/.prompt"]="$HOME/.prompt"
  ["$DOTFILES_DIR/shell/.screen/default"]="$HOME/.screen/default"
  ["$DOTFILES_DIR/shell/.screenrc"]="$HOME/.screenrc"
  ["$DOTFILES_DIR/shell/.tabletaliases"]="$HOME/.tabletaliases"
  ["$DOTFILES_DIR/editors/nvim/init.vim"]="$HOME/.vimrc"
  ["$DOTFILES_DIR/editors/nvim/init.vim"]="$HOME/.config/nvim/init.vim"
  ["$DOTFILES_DIR/editors/nvim/plugins.vim"]="$HOME/.config/nvim/plugins.vim"
  ["$DOTFILES_DIR/apps/containers.conf"]="$HOME/.config/containers/containers.conf"
  ["$DOTFILES_DIR/apps/.jq"]="$HOME/.jq"
  ["$DOTFILES_DIR/apps/config.toml"]="$HOME/.config/mise/config.toml"
  ["$DOTFILES_DIR/apps/uv/uv.toml"]="$HOME/.config/uv/uv.toml"
  ["$DOTFILES_DIR/apps/ranger/rc.conf"]="$HOME/.config/ranger/rc.conf"
  ["$DOTFILES_DIR/apps/ranger/rifle.conf"]="$HOME/.config/ranger/rifle.conf"
  ["$DOTFILES_DIR/shell/.tmux.conf"]="$HOME/.tmux.conf"
  ["$DOTFILES_DIR/shell/.bashrc"]="$HOME/.bashrc"
  ["$DOTFILES_DIR/shell/starship.toml"]="$HOME/.config/starship.toml"
  ["$DOTFILES_DIR/shell/twig.toml"]="$HOME/.config/twig/config.toml"
)

# ... and the ones only a desktop needs
declare -A DESKTOP_SYMLINKS=(
  ["$DOTFILES_DIR/desktop/.XResources"]="$HOME/.XResources"
  ["$DOTFILES_DIR/desktop/.xmodmap"]="$HOME/.xmodmap"
  ["$DOTFILES_DIR/desktop/.xsession"]="$HOME/.xsession"
  ["$DOTFILES_DIR/editors/keybindings.json"]="$HOME/.config/Code/User/keybindings.json"
  ["$DOTFILES_DIR/editors/vscode-terminal-on-open"]="$HOME/.vscode/extensions/jeffjose.terminal-on-open-0.0.1"
  ["$DOTFILES_DIR/apps/ipython_config.py"]="$HOME/.ipython/profile_default/ipython_config.py"
  ["$DOTFILES_DIR/apps/custom.js"]="$HOME/.jupyter/custom/custom.js"
  ["$DOTFILES_DIR/apps/audtag.yaml"]="$HOME/audtag.yaml"
  ["$DOTFILES_DIR/themes/material-theme-jeffjose"]="$HOME/.vscode/extensions/material-theme-jeffjose"
)

# Links this script used to make to files that have since left the repo. One
# that still points here is removed; anything else at that path is not ours.
RETIRED_LINKS=(
  "$HOME/.config/espanso/default.yml"
)

source "$DOTFILES_DIR/scripts/lib/host.sh"
PROFILE=$(host_profile)
if [ "$PROFILE" = desktop ]; then
  DIRECTORIES+=("${DESKTOP_DIRECTORIES[@]}")
  for src in "${!DESKTOP_SYMLINKS[@]}"; do
    SYMLINKS[$src]="${DESKTOP_SYMLINKS[$src]}"
  done
fi

# Output is cargo-style: a right-aligned coloured verb, then the detail.
# Only changes are printed; pass -v to also list what was already in place.
VERBOSE=0
[[ "${1:-}" == "-v" || "${1:-}" == "--verbose" ]] && VERBOSE=1

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  GREEN=$'\e[1;32m' YELLOW=$'\e[1;33m' RED=$'\e[1;31m' DIM=$'\e[2m' RESET=$'\e[0m'
else
  GREEN='' YELLOW='' RED='' DIM='' RESET=''
fi

changed=0
fresh=0
declare -a failed_tasks=()
start_us=${EPOCHREALTIME//[^0-9]/}

# say <colour> <verb> <detail>
say() { printf '%s%12s%s %s\n' "$1" "$2" "$RESET" "$3"; }

# Shorten a path for display: relative to the dotfiles repo, else ~-relative
short() {
  local path="$1"
  if [[ "$path" == "$DOTFILES_DIR/"* ]]; then
    path="${path#"$DOTFILES_DIR/"}"
  elif [[ "$path" == "$HOME"* ]]; then
    path="~${path#"$HOME"}"
  fi
  printf '%s' "$path"
}

# run <colour> <verb> <detail> <command...>: run a command, report and track it
run() {
  local colour="$1" verb="$2" detail="$3"
  shift 3
  if "$@" 2>/dev/null; then
    say "$colour" "$verb" "$detail"
    ((changed++)) || true
  else
    say "$RED" "Failed" "$detail"
    failed_tasks+=("$detail")
  fi
}

# Something that was already in place
skip() {
  ((fresh++)) || true
  [ $VERBOSE -eq 1 ] && say "$DIM" "Fresh" "$DIM$1$RESET"
  return 0
}

# Directories
for dir in "${DIRECTORIES[@]}"; do
  if [ -d "$dir" ]; then
    skip "$(short "$dir")"
  else
    run "$GREEN" "Creating" "$(short "$dir")" mkdir -p "$dir"
  fi
done

# Empty files
for file in /tmp/cwdcmd_recent_dirs "$HOME/.aliases.sensitive.sh"; do
  if [ -e "$file" ]; then
    skip "$(short "$file")"
  else
    run "$GREEN" "Creating" "$(short "$file")" touch "$file"
  fi
done

# link <source> <target>: symlink target → source, backing up a real file in the way
link() {
  local src="$1" target="$2"
  local detail="$(short "$target") → $(short "$src")"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
    skip "$detail"
    return 0
  fi
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    run "$YELLOW" "Backing up" "$(short "$target") → $(short "$target$BACKUP_SUFFIX")" mv "$target" "$target$BACKUP_SUFFIX"
  fi
  run "$GREEN" "Linking" "$detail" ln -sfn "$src" "$target"
}

# Bin scripts (scrn among them: it picks the newest screen installed)
for script in "$DOTFILES_DIR/bin/"*; do
  [ -f "$script" ] || continue
  link "$script" "$HOME/bin/$(basename "$script")"
done

# Symlinks, sorted by target so the output is stable
while IFS=$'\t' read -r target src; do
  link "$src" "$target"
done < <(for src in "${!SYMLINKS[@]}"; do printf '%s\t%s\n' "${SYMLINKS[$src]}" "$src"; done | sort)

for target in "${RETIRED_LINKS[@]}"; do
  if [ -L "$target" ] && [[ "$(readlink "$target")" == "$DOTFILES_DIR/"* ]]; then
    run "$YELLOW" "Unlinking" "$(short "$target") — no longer in the dotfiles" rm "$target"
  fi
done

# mise reads every file in ~/.config/mise/conf.d on top of config.toml, which is
# how one tool list becomes three: a desktop adds the bulk of the tools (see
# apps/mise-desktop.toml), and a corp host adds settings that keep some tools
# off it (see apps/mise-corp.toml). Where a file does not apply its link is
# taken away again, so a machine that changes profile, or was once misdetected,
# is not left with it.
#
# conf_d <wanted: 0|1> <name> <source> <why it is unlinked>
conf_d() {
  local wanted="$1" target="$HOME/.config/mise/conf.d/$2.toml" src="$3" why="$4"
  if [ "$wanted" -eq 1 ]; then
    [ -d "${target%/*}" ] || run "$GREEN" "Creating" "$(short "${target%/*}")" mkdir -p "${target%/*}"
    link "$src" "$target"
  elif [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
    run "$YELLOW" "Unlinking" "$(short "$target") — $why" rm "$target"
  fi
}

desktop=0 corp=0
[ "$PROFILE" = desktop ] && desktop=1
is_corp_host && corp=1
conf_d "$desktop" desktop "$DESKTOP_MISE_CONFIG" "not a desktop"
conf_d "$corp" corp "$CORP_MISE_CONFIG" "not a corp host"

elapsed_ms=$(((${EPOCHREALTIME//[^0-9]/} - start_us) / 1000))
summary="$PROFILE profile, $changed changed, $fresh up to date in ${elapsed_ms}ms"

if [ ${#failed_tasks[@]} -gt 0 ]; then
  say "$RED" "Finished" "${#failed_tasks[@]} failed, $summary"
  exit 1
else
  say "$GREEN" "Finished" "$summary"
fi
