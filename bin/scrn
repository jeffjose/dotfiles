#!/bin/sh
#
# scrn — run the newest GNU screen on this machine.
#
# A source build in ~/.local/bin (screen 5, which has truecolor) wins over the
# distro's /usr/bin/screen; a machine without one just gets the distro's.
#
# Screen 5 keeps its sockets in $SCREENDIR, which must be mode 700. Left unset
# that is ~/.screen, which setup creates 775 to hold the layout, so screen 5
# gets a directory of its own. Sessions from screen 4 stay in /run/screen and
# are reached with /usr/bin/screen.
#

# newer <a> <b>: is version a newer than version b?
newer() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

best= best_ver=
for bin in "$HOME/.local/bin/screen" /usr/local/bin/screen /usr/bin/screen; do
  [ -x "$bin" ] || continue
  ver=$("$bin" -v 2>/dev/null | sed -n 's/^Screen version \([0-9.]*\).*/\1/p')
  [ -n "$ver" ] || continue
  if [ -z "$best" ] || newer "$ver" "$best_ver"; then
    best=$bin best_ver=$ver
  fi
done

if [ -z "$best" ]; then
  echo "scrn: no screen installed" >&2
  exit 127
fi

case $best_ver in
  4.*) ;;
  *)
    export SCREENDIR="${SCREENDIR:-$HOME/.local/state/screen}"
    mkdir -p "$SCREENDIR" && chmod 700 "$SCREENDIR"
    ;;
esac

exec "$best" "$@"
