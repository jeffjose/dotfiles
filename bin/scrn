#!/bin/sh
#
# scrn — run the newest GNU screen on this machine, or the one that has the
# session you are after.
#
# A source build in ~/.local/bin (screen 5, which has truecolor) wins over the
# distro's /usr/bin/screen; a machine without one just gets the distro's.
#
# Screen 5 keeps its sockets in $SCREENDIR, which must be mode 700. Left unset
# that is ~/.screen, which setup creates 775 to hold the layout, so screen 5
# gets a directory of its own. Screen 4 keeps them in /run/screen, so neither
# version sees the other's sessions. When a command works on an existing
# session (-x, -r, -R, -d, -D, -X, -Q) and names it, with -S or by running
# inside it ($STY), scrn uses whichever installed screen has that session; only
# when none does is it the newest. So `scrn -x -R -S default` still reattaches
# a session started under screen 4 rather than starting a second one.
#

V5DIR="${SCREENDIR:-$HOME/.local/state/screen}"

# version <bin>: "5.0.2", or nothing if it isn't a screen.
version() {
  "$1" -v 2>/dev/null | sed -n 's/^Screen version \([0-9.]*\).*/\1/p'
}

# with_dir <version> <command...>: run it with the socket directory that
# version uses.
with_dir() {
  ver=$1
  shift
  case $ver in
    4.*) env -u SCREENDIR "$@" ;;
    *) SCREENDIR="$V5DIR" "$@" ;;
  esac
}

# Every screen installed, newest first, as "version bin" lines.
installed=$(
  for bin in "$HOME/.local/bin/screen" /usr/local/bin/screen /usr/bin/screen; do
    [ -x "$bin" ] || continue
    ver=$(version "$bin")
    [ -n "$ver" ] && echo "$ver $bin"
  done | sort -rV -k1,1 | awk '!seen[$1]++'
)
if [ -z "$installed" ]; then
  echo "scrn: no screen installed" >&2
  exit 127
fi
use=$(echo "$installed" | head -n 1)

# Which session, if the command is about an existing one.
existing="" name="" prev=""
for arg in "$@"; do
  [ "$prev" = -S ] && name=$arg
  case $arg in
    --* | -*m*) ;;
    -*[xrRdDXQ]*) existing=1 ;;
  esac
  prev=$arg
done
[ -n "$existing" ] && [ -z "$name" ] && name=$STY

if [ -n "$existing" ] && [ -n "$name" ]; then
  match=$(echo "$installed" | while read -r ver bin; do
    if with_dir "$ver" "$bin" -ls "$name" 2>/dev/null |
      grep -qE "(^|[[:space:]]|\.)$name[[:space:]]"; then
      echo "$ver $bin"
      break
    fi
  done)
  [ -n "$match" ] && use=$match
fi

ver=${use%% *}
bin=${use#* }
case $ver in
  4.*) exec env -u SCREENDIR "$bin" "$@" ;;
esac
mkdir -p "$V5DIR" && chmod 700 "$V5DIR"
export SCREENDIR="$V5DIR"
exec "$bin" "$@"
