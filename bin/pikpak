#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "questionary",
# ]
# ///

import sys
import re
import shutil
import subprocess
from urllib.parse import unquote_plus


def extract_magnets(text):
    pattern = r"magnet:\?[^\s\"'<>\]]+"
    return list(dict.fromkeys(re.findall(pattern, text)))  # deduplicated, order preserved


def label(magnet):
    dn = re.search(r"[&?]dn=([^&]+)", magnet)
    if dn:
        return unquote_plus(dn.group(1))
    return magnet[:80]


def check_rclone():
    """Fail before the paste, not once per magnet afterwards.

    rclone only grew the pikpak backend in v1.62, and an older one — Ubuntu
    still ships 1.53 — reports that as `didn't find backend called "pikpak"`
    on every submission. That reads like a broken remote, so it sends you to
    rclone.conf, which is the wrong file. Ask the binary what it can do
    instead, and name the binary asked: the usual cause is a current rclone
    installed but an old shell still resolving the old one.
    """
    try:
        backends = subprocess.run(
            ["rclone", "help", "backends"], capture_output=True, text=True
        ).stdout
    except FileNotFoundError:
        sys.exit("No rclone on PATH. Install one with: mise use -g rclone@latest")

    if not re.search(r"^\s*pikpak\s", backends, re.M):
        version = subprocess.run(
            ["rclone", "version"], capture_output=True, text=True
        ).stdout.splitlines()
        sys.exit(
            f"{shutil.which('rclone')} is {version[0] if version else 'an unknown version'}, "
            "which has no pikpak backend (needs v1.62+).\n"
            "Install a current one with: mise use -g rclone@latest\n"
            "If you just did, open a new shell — this one still has the old PATH."
        )


def main():
    import questionary

    if len(sys.argv) < 2:
        print("Usage: pikpak <folder>", file=sys.stderr)
        print("  e.g. pikpak tvshows", file=sys.stderr)
        print("       pikpak movies", file=sys.stderr)
        sys.exit(1)

    folder = sys.argv[1]

    check_rclone()

    print("Paste text containing magnet links, then press Ctrl+D:")
    try:
        text = sys.stdin.read()
    except KeyboardInterrupt:
        sys.exit(0)

    magnets = extract_magnets(text)

    if not magnets:
        print("No magnet links found.")
        sys.exit(0)

    print(f"\nFound {len(magnets)} magnet link(s).\n")

    choices = [questionary.Choice(title=label(m), value=m) for m in magnets]

    selected = questionary.checkbox(
        f"Select to send to pikpak:{folder}",
        choices=choices,
    ).ask()

    if not selected:
        print("Nothing selected.")
        sys.exit(0)

    print()
    for magnet in selected:
        name = label(magnet)
        print(f"Submitting: {name}")
        result = subprocess.run(
            ["rclone", "backend", "addurl", f"pikpak:{folder}", magnet],
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            print(f"  OK")
        else:
            print(f"  ERROR: {result.stderr.strip()}")


if __name__ == "__main__":
    main()
